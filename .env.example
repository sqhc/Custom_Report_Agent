# 海关报关智能生成系统 - 环境变量示例
#
# 用法：
#   cp .env.example .env    # 然后填入你自己的密钥
#   （python-dotenv 已安装时会自动加载 .env；也可直接 export 这些变量）
#
# 注意：环境变量在 Python 进程启动时读取，
#       修改后需要重启程序才会生效。

# ============================================================================
# 后端选择
# ============================================================================
# "ollama" = 本地模型（默认，向后兼容）
# "openai" = 任何兼容 OpenAI 接口的远程服务
LLM_BACKEND=ollama

# ============================================================================
# 本地 Ollama 配置（LLM_BACKEND=ollama 时生效）
# ============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:27b
OLLAMA_TIMEOUT=120

# ============================================================================
# 远程 OpenAI 兼容服务配置（LLM_BACKEND=openai 时生效）
# 缺少 OPENAI_API_KEY 时程序会在启动阶段直接报错退出
# ============================================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=120
# 可选的降级模型，留空表示不降级
OPENAI_FALLBACK_MODEL=

# 通用重试配置（仅远程模式使用）
# 遇到 429/5xx/超时会重试；401/403/404 等错误不会重试
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=1.0

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============================================================================
# 各服务商配置参考
# ============================================================================
#
# --- OpenAI ---
#   LLM_BACKEND=openai
#   OPENAI_API_KEY=sk-xxxxxxxx
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o
#
# --- DeepSeek ---
#   LLM_BACKEND=openai
#   OPENAI_API_KEY=sk-xxxxxxxx
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_MODEL=deepseek-chat
#
# --- Moonshot (Kimi) ---
#   LLM_BACKEND=openai
#   OPENAI_API_KEY=sk-xxxxxxxx
#   OPENAI_BASE_URL=https://api.moonshot.cn/v1
#   OPENAI_MODEL=moonshot-v1-8k
#
# --- 本地 vLLM / LM Studio / One-API 等兼容网关 ---
#   LLM_BACKEND=openai
#   OPENAI_API_KEY=not-needed
#   OPENAI_BASE_URL=http://localhost:8000/v1
#   OPENAI_MODEL=<你的模型名>
